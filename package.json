{
  "name": "gemini-mermaid",
  "version": "1.0.2",
  "description": "Firefox extension that identifies and renders Mermaid diagrams in the Google Gemini web app.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "vitest run",
    "lint": "web-ext lint --self-hosted --source-dir dist",
    "package": "web-ext build --source-dir dist --artifacts-dir web-ext-artifacts --overwrite-dest",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "mermaid": "^11.4.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.8",
    "web-ext": "^8.3.0"
  }
}
